                            '@type': 'Organization',
                            name: 'Pest Control Noida'
                        },
                        areaServed: {
                            '@type': 'Place',
                            name: area.locationName
                        },
                        description: area.seoDescription || `Professional pest control services in ${area.locationName}.`,
                    })
                }}
            />
        </div>
    );
}
