import { defineField, defineType } from 'sanity'

export default defineType({
    name: 'pest',
    title: 'Pest Library',
    type: 'document',
    fields: [
        defineField({
            name: 'commonName',
            title: 'Common Name',
            type: 'string',
        }),
        defineField({
            name: 'scientificName',
            title: 'Scientific Name',
            type: 'string',
        }),
        defineField({
            name: 'slug',
            title: 'Slug',
            type: 'slug',
            options: {
                source: 'commonName',
                maxLength: 96,
            },
        }),
        defineField({
            name: 'image',
            title: 'Image',
            type: 'image',
            options: { hotspot: true },
        }),
        defineField({
            name: 'mainImageExternalUrl',
            title: 'Primary Image URL (Cloudinary)',
            type: 'url',
            description: 'Optional: Use an external URL (e.g., Cloudinary) instead of uploading an image.',
